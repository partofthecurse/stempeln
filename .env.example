STEMPELN_IMAGE=ghcr.io/partofthecurse/stempeln:latest
# 127.0.0.1 = nur auf dem Docker-Host; für Zugriff aus dem Heimnetz die LAN-IP des Hosts eintragen
STEMPELN_BIND_ADDRESS=127.0.0.1
STEMPELN_PORT=32769
STEMPELN_DATA_VOLUME=stempeln-data
TZ=Europe/Berlin
MONITOR_INTERVAL_SECONDS=60
# Sprache, wenn weder Konto noch Browser eine unterstützte Sprache liefern (de oder en)
DEFAULT_LANGUAGE=de
# Nur hinter einem HTTPS-Reverse-Proxy auf true setzen
COOKIE_SECURE=false
TRUST_PROXY=false
