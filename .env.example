STEMPEL_IMAGE=ghcr.io/partofthecurse/stempel:latest
# 127.0.0.1 = nur auf dem Docker-Host; für Zugriff aus dem Heimnetz die LAN-IP des Hosts eintragen
STEMPEL_BIND_ADDRESS=127.0.0.1
STEMPEL_PORT=32769
STEMPEL_DATA_VOLUME=stempel-data
TZ=Europe/Berlin
MONITOR_INTERVAL_SECONDS=60
# Nur hinter einem HTTPS-Reverse-Proxy auf true setzen
COOKIE_SECURE=false
TRUST_PROXY=false
